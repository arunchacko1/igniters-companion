# Production environment variables.
# On Hugging Face Spaces these are set as Space *Secrets* (Settings →
# Variables and secrets), not committed here. See docs/DEPLOY-HF.md.

# Supabase Postgres connection string (use the Session pooler, port 5432).
DATABASE_URL=postgres://postgres.REF:CHANGE_ME@aws-0-REGION.pooler.supabase.com:5432/postgres

# Long random string used to sign session JWTs.
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# Groq API key (https://console.groq.com).
GROQ_API_KEY=CHANGE_ME

NODE_ENV=production
