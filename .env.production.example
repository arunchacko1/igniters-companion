# Copy to `.env` on the EC2 host (next to docker-compose.prod.yml).
# Never commit the real .env.

# RDS Postgres connection string.
DATABASE_URL=postgres://igniters:CHANGE_ME@your-instance.xxxxxx.us-east-1.rds.amazonaws.com:5432/igniters

# Long random string used to sign session JWTs.
JWT_SECRET=CHANGE_ME_use_a_long_random_string

# Groq API key (https://console.groq.com).
GROQ_API_KEY=CHANGE_ME

NODE_ENV=production
